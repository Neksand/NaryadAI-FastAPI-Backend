# Legacy profile includes Moto. For durable production use .env.production.example.
# Server profile: the base Docker image runs API integrations only.
# Copy to .env.server and replace every CHANGE_ME value before deployment.
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
POSTGRES_DB=naryadai
POSTGRES_USER=naryadai
POSTGRES_PASSWORD=CHANGE_ME_long_alphanumeric
DATABASE_URL=postgresql://naryadai:CHANGE_ME_long_alphanumeric@postgres:5432/naryadai
COMPOSE_DATABASE_URL=postgresql://naryadai:CHANGE_ME_long_alphanumeric@postgres:5432/naryadai
COMPOSE_REDIS_URL=redis://redis:6379
COMPOSE_S3_ENDPOINT=http://s3:9000
REDIS_URL=redis://redis:6379
ACCESS_TOKEN_SECRET=CHANGE_ME_generate_a_random_secret_at_least_32_chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=https://your-frontend.example,tauri://localhost,http://tauri.localhost,https://tauri.localhost
S3_ENDPOINT=http://s3:9000
S3_REGION=us-east-1
S3_BUCKET=naryadai-uploads
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_BYTES=10485760
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PIN=CHANGE_ME_6_DIGITS
PDF_FONT_PATH=

# Server uses hosted providers. It never imports or downloads Estimin3n weights.
AI_MODE=external
# Explicit opt-in only after data anonymization and provider validation.
AI_EXTERNAL_ENABLED=false
AI_TEXT_PROVIDER=gemini
AI_VISION_PROVIDER=gemini
AI_AUDIO_PROVIDER=groq
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=CHANGE_ME
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
ESTIMIN3N_ENABLED=false
ESTIMIN3N_MODEL_ID=govnejri/Estimin3n
ESTIMIN3N_DEVICE=auto
ESTIMIN3N_LOAD_IN_4BIT=false
ESTIMIN3N_CACHE_DIR=.hf-cache
PUSH_ENABLED=false
STORAGE_TYPE=s3
STORAGE_PATH=./storage
