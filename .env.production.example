NODE_ENV=production
FRONTEND_DOMAIN=naryad-ai.kz
API_DOMAIN=api.naryad-ai.kz
ACME_EMAIL=replace-with-your-email
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DB_PASSWORD
COMPOSE_DATABASE_URL=postgresql://naryadai:REPLACE_WITH_URL_ENCODED_DB_PASSWORD@postgres:5432/naryadai
DATABASE_URL=postgresql://naryadai:REPLACE_WITH_URL_ENCODED_DB_PASSWORD@postgres:5432/naryadai
REDIS_URL=redis://redis:6379/0
ACCESS_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
CORS_ORIGINS=https://naryad-ai.kz
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PIN=REPLACE_WITH_RANDOM_8_DIGIT_PIN
S3_ENDPOINT=https://replace-with-durable-s3-endpoint
S3_REGION=us-east-1
S3_BUCKET=naryadai-production
S3_ACCESS_KEY=REPLACE_WITH_RESTRICTED_BUCKET_KEY
S3_SECRET_KEY=REPLACE_WITH_RESTRICTED_BUCKET_SECRET
S3_FORCE_PATH_STYLE=true
AI_MODE=mock
AI_EXTERNAL_ENABLED=false
AI_TEXT_PROVIDER=off
AI_VISION_PROVIDER=off
AI_AUDIO_PROVIDER=off
ESTIMIN3N_ENABLED=false
# Enable a chosen AI provider only after a separate data/privacy review.
