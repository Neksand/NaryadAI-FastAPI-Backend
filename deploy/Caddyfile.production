{
    email {$ACME_EMAIL}
    admin off
}

{$FRONTEND_DOMAIN} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
    }
    handle /api/* {
        reverse_proxy api:8080
    }
    handle {
        root * /srv/web
        try_files {path} /index.html
        file_server
    }
}

{$API_DOMAIN} {
    reverse_proxy api:8080
}
