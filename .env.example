NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
DATABASE_URL=postgresql://naryadai:naryadai@localhost:5432/naryadai
REDIS_URL=redis://localhost:6379
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=naryadai-uploads
S3_ACCESS_KEY=minio
S3_SECRET_KEY=miniosecret
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_BYTES=10485760
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PIN=1234
PDF_FONT_PATH=
# --- External AI: all optional. Without keys the local rules-v1 engine is used.
# AI_MODE=mock  -> fully offline demo (default). AI_MODE=external -> use providers below.
# Where to get free keys:
#   GEMINI_API_KEY     - https://aistudio.google.com (free quota, text+vision; recommended: covers everything)
#   OPENROUTER_API_KEY - https://openrouter.ai (free :free models, no card)
#   GROQ_API_KEY       - https://console.groq.com (free tier text + Whisper transcription for voice notes)
# No key for Pollinations fallback (https://pollinations.ai, free community, no SLA).
AI_MODE=mock
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_TEXT_PROVIDER=auto
AI_VISION_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# --- Push: in-app notifications (DB) + WebSocket only. No external push services. ---
PUSH_ENABLED=false
# --- Storage ---
# S3-compatible backend (moto-based service in compose, any S3 for prod).
STORAGE_TYPE=s3
STORAGE_PATH=./storage
