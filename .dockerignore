# Keep the Docker build context small and secret-free.
.git
.gitignore
.github
.idea
.vscode

# Local env / secrets
.env
.env.*
!.env.example
!.env.server.example

# Python venv & caches
.venv
__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache
